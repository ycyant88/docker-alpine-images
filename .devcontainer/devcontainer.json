{
	"name": "Dev Containers docker-alpine-images",
	"build": {
		"dockerfile": "Dockerfile",
		"args": {
			"VARIANT": "ubuntu24.04"
		}
	},
	"mounts": [
		"source=dev-containers-docker-alpine-images-bashhistory,target=/home/vscode/commandhistory"
	],
	"remoteUser": "vscode",
	"features": {
		"ghcr.io/devcontainers/features/aws-cli:1": {},
		"ghcr.io/devcontainers/features/copilot-cli:1": {},
		"ghcr.io/devcontainers/features/docker-in-docker:4.0.0": {
			"moby": true,
			"installDockerBuildx": true
		}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"github.copilot-chat",
				"hashicorp.hcl"
			]
		}
	}
}
